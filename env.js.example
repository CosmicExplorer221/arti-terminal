// Local environment configuration
// Copy this file to env.js and add your actual API keys

window.GEMINI_API_KEY = '';  // Get from: https://makersuite.google.com/app/apikey

// Gemini model to use (default: gemini-2.5-flash)
// Available models: gemini-2.5-flash, gemini-2.0-flash-exp, gemini-1.5-pro, etc.
window.GEMINI_MODEL = 'gemini-2.5-flash';

// For local development, use the proxy server (runs on port 3001)
// This bypasses CORS restrictions when testing locally
window.SLACK_WEBHOOK_URL = 'http://localhost:3001/slack';

// Note: The actual Slack webhook URL should be set in slack-proxy.js
// or as an environment variable SLACK_WEBHOOK_URL
